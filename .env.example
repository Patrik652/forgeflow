# Optional local Docker Compose setting. Demo requires no provider credentials.
GENERIC_TIMEZONE=Europe/Bratislava

# n8n uses its built-in owner account setup; legacy N8N_BASIC_AUTH_* is unsupported.
# For optional integrations, configure credentials inside n8n's credential store.
# Set spreadsheet ID / chat ID directly on their disabled template nodes.
# Enable providers deliberately in the editor only after reviewing each external effect.
