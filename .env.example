# Copy to .env and fill before recording the live demo. NEVER commit .env.
# Anthropic (Claude classification node)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Google Sheets (status board) — service account JSON path or OAuth as per n8n creds
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_JSON=

# Telegram (late / high-priority alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# n8n basic auth (local docker)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme
