    {
      "parameters": {
        "jsCode": "return [\n  { json: { job_id: 'J-1001', part_name: 'Spindle housing', material: 'Aluminium 6061', qty: 12, due_date: '2026-06-25', requested_machine: 'milling', customer: 'Vortex Drives', notes: 'standard tolerance +/-0.05mm' } },\n  { json: { job_id: 'J-1002', part_name: 'Drive shaft', material: 'Steel 4140', qty: 40, due_date: '2026-06-09', requested_machine: 'turning', customer: 'Kessler Automotive', notes: 'OVERDUE - customer escalated twice' } },\n  { json: { job_id: 'J-1003', part_name: 'Sensor bracket', material: 'Stainless 316', qty: 200, due_date: '2026-06-12', requested_machine: 'laser', customer: 'NordHVAC', notes: 'tight slot pattern at-risk' } },\n  { json: { job_id: 'J-1004', part_name: 'Mold insert', material: 'Tool steel H13', qty: 2, due_date: '2026-07-02', requested_machine: 'edm', customer: 'PrecisionMold GmbH', notes: 'fine EDM finish required' } },\n  { json: { job_id: 'J-1005', part_name: 'Flange ring', material: 'Aluminium 7075', qty: 25, due_date: '2026-06-10', requested_machine: 'turning', customer: 'Vortex Drives', notes: 'high priority - line stoppage if late' } },\n  { json: { job_id: 'J-1006', part_name: 'Cover plate', material: 'Brass C360', qty: 60, due_date: '2026-06-28', requested_machine: 'milling', customer: 'Kessler Automotive', notes: 'low priority restock' } },\n  { json: { job_id: 'J-1007', part_name: 'Heat exchanger fin', material: 'Copper C110', qty: 500, due_date: '2026-06-13', requested_machine: 'laser', customer: 'NordHVAC', notes: 'batch run at-risk on capacity' } },\n  { json: { job_id: 'J-1008', part_name: 'Gear blank', material: 'Steel 4140', qty: 18, due_date: '2026-06-24', requested_machine: 'turning', customer: 'PrecisionMold GmbH', notes: 'standard' } }\n];"
      },
      "id": "bd1f3d51-8f32-4073-a071-971f7d5fb809",
      "name": "Sample CSV Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -680,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "return items.map((item) => {\n  const body = item.json.body ?? item.json;\n  return {\n    json: {\n      job_id: body.job_id,\n      part_name: body.part_name,\n      material: body.material,\n      qty: Number(body.qty),\n      due_date: body.due_date,\n      requested_machine: String(body.requested_machine || '').toLowerCase(),\n      customer: body.customer,\n      notes: body.notes || '',\n      received_at: new Date().toISOString()\n    }\n  };\n});"
      },
      "id": "9f7da690-d871-4f6e-bc61-83e758f53a7a",
      "name": "Normalize Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -420,
        20
      ]
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "model": "claude-sonnet-4-5",
        "prompt": "Classify this CNC production job. Return compact JSON only with keys priority (low|medium|high), machine_type (milling|turning|laser|edm), eta_risk (on_track|at_risk|late), and reason. Today is 2026-06-11. Late means due_date is before today. High priority includes notes containing high priority, line stoppage, escalated, or OVERDUE. Job: {{$json}}",
        "options": {
          "maxTokens": 300,
          "temperature": 0
        }
      },
      "id": "8ed917d8-7372-45a7-8a4e-b3e428970e1f",
      "name": "Claude / Anthropic Classifier",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        -120,
        20
      ],
      "credentials": {
        "anthropicApi": {
          "id": "__REPLACE_WITH_ANTHROPIC_CREDENTIAL_ID__",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return items.map((item) => {\n  const job = item.json;\n  const text = job.text || job.output || job.completion || job.response || '{}';\n  let classification;\n  try {\n    classification = typeof text === 'string' ? JSON.parse(text.replace(/^```json\\s*|```$/g, '').trim()) : text;\n  } catch (error) {\n    classification = {\n      priority: 'medium',\n      machine_type: job.requested_machine,\n      eta_risk: 'at_risk',\n      reason: 'Classifier returned non-JSON; planner review required'\n    };\n  }\n\n  return {\n    json: {\n      ...job,\n      priority: classification.priority,\n      machine_type: classification.machine_type || job.requested_machine,\n      eta_risk: classification.eta_risk,\n      classification_reason: classification.reason,\n      alert_required: classification.eta_risk === 'late' || classification.priority === 'high'\n    }\n  };\n});"
      },
